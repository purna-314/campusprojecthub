# =============================================================================
# Campus Project Hub — Server Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to Git.
# =============================================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Authentication (REQUIRED in production) ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_use_a_strong_random_string
JWT_EXPIRES_IN=7d

# --- CORS (Required in production) ---
# Set to your Vercel frontend URL, e.g. https://campusprojecthub.vercel.app
CLIENT_URL=http://localhost:5173

# --- MongoDB Atlas Cloud Connection (Optional) ---
# If not set, the server falls back to local JSON storage (server/data/db.json).
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campus_project_hub?retryWrites=true&w=majority

# --- SMTP Email (Optional) ---
# If not set, OTP codes are printed to console / Ethereal test mail is used.
# For Gmail: use an App Password (not your real Gmail password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_app_password
# EMAIL_FROM="Campus Project Hub" <no-reply@campusprojecthub.edu>
