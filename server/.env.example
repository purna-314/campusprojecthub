# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Cloud Connection String (Optional, falls back to local storage)
# Replace <username> and <password> with your Atlas DB credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campus_project_hub?retryWrites=true&w=majority

# SMTP Email Configuration for Real Email Verification (Optional)
# If left empty, verification OTP codes are logged to console and provided in test mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Campus Project Hub" <no-reply@campusprojecthub.edu>
